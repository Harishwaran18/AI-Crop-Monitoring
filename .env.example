# Copy to .env and fill in locally. Never commit .env.

# --- Snapshot / simulation ---
CROPMON_SEED=42
CROPMON_GRID_ROWS=96
CROPMON_GRID_COLS=96
CROPMON_ZONE_ROWS=16
CROPMON_ZONE_COLS=16
CROPMON_SENSOR_DAYS=14
CROPMON_HISTORY_WEEKS=12

# Optional: relocate generated files
# CROPMON_DATA_DIR=./data
# CROPMON_ARTIFACTS_DIR=./artifacts
# CROPMON_FIGURES_DIR=./docs/figures

# --- SMS delivery (console by default) ---
CROPMON_SMS_CHANNEL=console
ALERT_RECIPIENT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=TXTIND
